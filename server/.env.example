OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
# Legacy compatibility alias; only used when OLLAMA_CHAT_MODEL is omitted.
# OLLAMA_MODEL=qwen3:4b
OLLAMA_TRANSLATION_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=10m
OLLAMA_CHAT_TEMPERATURE=0.78
OLLAMA_CHAT_NUM_PREDICT=240
OLLAMA_TRANSLATION_TEMPERATURE=0.1
OLLAMA_TRANSLATION_NUM_PREDICT=256
OLLAMA_THINK=false
OLLAMA_NUM_CTX=2048
AI_STREAMING=true
AI_BACKGROUND_IDLE_DELAY_MS=350
AI_RESOURCE_MODE=auto
AI_LOW_MEMORY_RAM_THRESHOLD_GB=8
OLLAMA_TIMEOUT_MS=60000
STT_PROVIDER=faster-whisper
FASTER_WHISPER_URL=http://127.0.0.1:8765
STT_BROWSER_FALLBACK=true
STT_MAX_AUDIO_BYTES=20971520
STT_MAX_RECORDING_MS=120000
STT_REQUEST_TIMEOUT_MS=120000
STT_IDLE_UNLOAD_MS=20000
STT_LEASE_TIMEOUT_MS=180000
TTS_PROVIDER=kokoro
KOKORO_TTS_URL=http://127.0.0.1:8766
TTS_BROWSER_FALLBACK=true
TTS_REQUEST_TIMEOUT_MS=120000
TTS_MAX_TEXT_CHARS=4000
TTS_IDLE_UNLOAD_MS=15000
PORT=3001
AI_DEMO_MODE=false
AI_DEMO_BACKGROUND_IDLE_DELAY_MS=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=ai_english_friend
DEV_USER_EMAIL=dev@example.com
PERF_LOG=true
